# ALL settings of the UI live in this file. Copy it to ".env" (next to package.json) and edit it.
# Real environment variables override the file. Restart the UI server (npm start) after changing it.
# There is no config.js any more: the UI server hands the page the two non-secret page settings below.

# Address of the config server (the UI server reads the page settings from it)
FOUNDRY_CONFIG_URL=http://localhost:8888

# The id and secret this UI uses to get a token from the config server. They must match a client there.
CONFIG_CLIENT_ID=ui
CONFIG_CLIENT_SECRET=ui-secret

# Where /api is forwarded: the Spring Boot backend
API_PROXY=http://127.0.0.1:8080

# Page settings (non-secret; the browser receives these two)
# Leave empty to call the backend through this server's /api (recommended). Set an address only to call a backend directly
# from another host, e.g. https://api.example.com. That backend must then allow this UI's address in gym.cors-origins.
FOUNDRY_API_BASE=
# Set to false to ignore the config server completely and use the built-in names, currency, banner and footer.
FOUNDRY_CONFIG_ENABLED=true
